GROQ_API_KEY=your_groq_api_key_here

# OpenAI — fallback 1 of the LLM cleaner (post-processing dictated text)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini — primary cleaner provider + manual refiner
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cleaner provider chain (override only if you want a different model than the defaults):
#   1. Gemini 3.1 Flash-Lite  ← primary
#   2. GPT-5.4 mini           ← fallback 1
#   3. Groq gpt-oss-120b      ← fallback 2
# GEMINI_CLEANER_MODEL=gemini-3.1-flash-lite
# OPENAI_CLEANER_MODEL=gpt-5.4-mini
# GROQ_CLEANER_MODEL=openai/gpt-oss-120b

# Refiner manual (different from cleaner — used for the "refine prompt" button)
# GEMINI_MODEL=gemini-3.5-flash

# Cleaner behavior (optional — defaults shown)
# CLEANER_ENABLED=true          # set to false to disable LLM post-processing entirely
# CLEANER_MIN_WORDS=8           # skip cleaning texts shorter than this word count
# CLEANER_TIMEOUT_SECONDS=4.0   # hard timeout per LLM call (seconds)

# Transcription language (optional)
# WHISPER_LANGUAGE=es           # "es" anchors Spanish; set empty for auto-detect (multi-language)

# Transcription resilience (optional — defaults shown)
# TRANSCRIBE_TIMEOUT_SECONDS=45           # hard timeout per ASR call
# TRANSCRIBE_GROQ_ATTEMPTS=2              # Groq retries before cross-vendor fallback
# OPENAI_TRANSCRIBE_FALLBACK=true         # fall back to OpenAI ASR if Groq fails (needs OPENAI_API_KEY)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Session cap (optional)
# MAX_RECORDING_SECONDS=720     # auto-stop + transcribe after 12 min (0 disables)

# App-context aware cleaning (optional — defaults shown)
# APP_CONTEXT_ENABLED=true      # adapt tone/format to the foreground app (email/chat/code/ai/notes/docs)
# APP_CONTEXT_SEND_TITLE=false  # include the window title in the LLM message (privacy trade-off)

# Mute the keyboard shortcuts while a fullscreen game is focused (default true).
# Also mutes during fullscreen video and slideshow presentations — the tray
# icon click always works as an escape hatch. Set to false to disable.
# GAME_MUTE_ENABLED=true

# ---------------------------------------------------------------------------
# English practice mode (Ctrl+Alt+Space). Uses the same keys as above:
# Whisper (English) for the transcription, OpenAI or Groq for the corrections,
# and Gemini for the native-voice audio (GEMINI_API_KEY).
# ---------------------------------------------------------------------------
# ENGLISH_MODE_HOTKEY=ctrl+alt+space   # empty value turns the mode off
# ENGLISH_POPUP_ENABLED=true           # corrections panel
# ENGLISH_SHADOWING_ENABLED=true       # microphone button: repeat the sentence and get a score
# ENGLISH_EXPLAIN_ENABLED=true         # "Explain" mini-lesson button
# ENGLISH_TTS_PROVIDER=gemini
# ENGLISH_TTS_VOICE=Iapetus

# Which provider transcribes first: "openai" (default) or "groq"
# ASR_PRIMARY=openai

# Keep the last recordings on disk for N hours (SAVE_RECORDINGS=false disables it)
# SAVE_RECORDINGS=true
# RECORDINGS_RETENTION_HOURS=24
